# Copy to `.env` for local development. Never commit real secrets.
#
# Generate the development key material first:
#   ./scripts/generate-dev-secrets.sh
#
# Every secret is read from the `*_FILE` mount first; the plain environment
# variable is a development/test fallback only.
APP_ENV=development

# Database (development defaults match deploy/compose.yaml).
DATABASE_URL=postgres://rs_admin:rs_admin_dev@127.0.0.1:5432/rs_admin
# DATABASE_URL_FILE=/run/secrets/database_url

# Public origins. Production values must be https:// absolute origins.
PUBLIC_API_ORIGIN=http://localhost:8080
ADMIN_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only peers in these ranges may supply forwarding headers.
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Listeners. The metrics listener must stay on the internal network.
API_ADDR=0.0.0.0:8080
METRICS_ADDR=0.0.0.0:9100

# Connection pool (spec defaults).
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
DATABASE_IDLE_TIMEOUT_SECONDS=600
DATABASE_MAX_LIFETIME_SECONDS=1800

# JWT identity and keys. The signing key must be an Ed25519 PKCS#8 PEM; the
# optional previous public key verifies tokens signed before a rotation.
JWT_ISSUER=rs-admin
JWT_AUDIENCE=rs-admin-client
JWT_EDDSA_KID=dev-2026-11
JWT_EDDSA_PRIVATE_KEY_FILE=deploy/secrets-dev/jwt-ed25519-private.pem
# JWT_EDDSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# JWT_EDDSA_PREVIOUS_PUBLIC_KEY_FILE=deploy/secrets-dev/jwt-ed25519-previous-public.pem

# Refresh derivation and throttle HMAC keys (base64, at least 32 bytes).
REFRESH_DERIVATION_KEY_FILE=deploy/secrets-dev/refresh-derivation.key
# REFRESH_DERIVATION_KEY_PREVIOUS_FILE=deploy/secrets-dev/refresh-derivation-previous.key
THROTTLE_KEY_FILE=deploy/secrets-dev/throttle.key

# Audit chain key ring: JSON object of `key_id -> base64 key`. The current
# key id must be present; old keys stay for at least 365 days.
AUDIT_CHAIN_KEY_ID=dev-2026-11
AUDIT_CHAIN_KEYS_FILE=deploy/secrets-dev/audit-chain-keys.json

# Authentication limits (spec defaults).
PASSWORD_HASH_CONCURRENCY=4
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=600
LOGIN_IP_LOCK_SECONDS=900
LOGIN_GLOBAL_ALERT_LIMIT=200
LOGIN_GLOBAL_CIRCUIT_LIMIT=1000
LOGIN_GLOBAL_WINDOW_SECONDS=300
LOGIN_GLOBAL_LOCK_SECONDS=60
ACCOUNT_FAILURE_DECAY_HOURS=24
TEMP_PASSWORD_TTL_HOURS=72
REAUTH_MAX_AGE_SECONDS=300

# Audit retention floors (may be raised, never lowered).
AUDIT_RETENTION_INFO_DAYS=180
AUDIT_RETENTION_CRITICAL_DAYS=365

# Logging. Invalid directives abort startup.
RUST_LOG=info,sqlx=warn

# Docker Compose development database.
POSTGRES_DB=rs_admin
POSTGRES_USER=rs_admin
POSTGRES_PASSWORD=rs_admin_dev
POSTGRES_PORT=5432
