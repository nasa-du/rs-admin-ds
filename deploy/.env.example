# Copy to deploy/.env for the single-host stack. This file is non-secret;
# key material lives in the directory referenced by RS_ADMIN_SECRETS_DIR.
#
#   cp deploy/.env.example deploy/.env
#   ./scripts/generate-dev-secrets.sh
#
# For production replace RS_ADMIN_SECRETS_DIR with /etc/rs-admin/secrets, set
# APP_ENV=production, and point the image tags at immutable GHCR tags.

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=rs-admin
RS_ADMIN_SECRETS_DIR=./secrets-dev

# --- Images ----------------------------------------------------------------
# Production uses immutable GHCR tags (sha-<short> or vX.Y.Z); never `latest`.
# `scripts/release.sh` rewrites API_IMAGE/WEB_IMAGE/DB_IMAGE/GIT_COMMIT on each
# release. DB_IMAGE is the PostgreSQL 18.6 + pgBackRest image built from
# deploy/db/Dockerfile.
DB_IMAGE=rs-admin-db:local
API_IMAGE=rs-admin-api:local
WEB_IMAGE=rs-admin-web:local
GIT_COMMIT=unknown

# --- Domains and browser origins ------------------------------------------
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
ADMIN_ORIGIN=https://admin.example.com
PUBLIC_API_ORIGIN=https://api.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com
# Origin only, no /api/v1 suffix: the generated client already carries it.
VITE_API_BASE_URL=https://api.example.com

# --- Runtime ---------------------------------------------------------------
# production requires HTTPS origins and sslmode=verify-full in the DSN.
APP_ENV=production
TRUSTED_PROXY_CIDRS=172.28.0.0/16
JWT_ISSUER=rs-admin
JWT_AUDIENCE=rs-admin-client
JWT_EDDSA_KID=dev-2026-11
# Set only while compose.rotation-jwt.yaml is active (see the secret-rotation
# runbook). The previous public key file is mounted by that override.
# JWT_EDDSA_PREVIOUS_KID=jwt-2026-05
AUDIT_CHAIN_KEY_ID=dev-2026-11
PASSWORD_HASH_CONCURRENCY=4
RUST_LOG=info,sqlx=warn

# --- Retention -------------------------------------------------------------
AUDIT_RETENTION_INFO_DAYS=180
AUDIT_RETENTION_CRITICAL_DAYS=365

# --- Backup (local-db + backup profile) ------------------------------------
# pgBackRest writes to an S3-compatible repository. Credentials and the
# repository cipher pass live in the secrets directory; these coordinates are
# non-secret.
BACKUP_S3_BUCKET=rs-admin-backups
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_URI_STYLE=path
BACKUP_RETENTION_DAYS=30
# Must be writable by the backup container (uid/gid 70) and readable by
# node_exporter. The systemd units create it.
RS_ADMIN_METRICS_DIR=/var/lib/rs-admin/metrics
# The maintenance container runs as uid/gid 10001, so it has a separate
# metrics directory; node_exporter should collect from both.
RS_ADMIN_MAINTENANCE_METRICS_DIR=/var/lib/rs-admin/metrics-maintenance
RESTORE_DRILL_STATE_DIR=/var/lib/rs-admin/restore-drills
# PostgreSQL 18 -> 19 upgrade drill records (scripts/upgrade-drill.sh).
UPGRADE_DRILL_STATE_DIR=/var/lib/rs-admin/upgrade-drills
# Target image for the upgrade drill maintenance image. Move to the newest
# postgres:19.x-alpine after PG19 GA; the Dockerfile default must match.
PG_UPGRADE_NEW_IMAGE=postgres:19rc1-alpine

# --- Observability ---------------------------------------------------------
# Pinned images for the separate observability Compose file. Override only to
# move to a reviewed release.
PROMETHEUS_IMAGE=prom/prometheus:v3.0.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.0
GRAFANA_IMAGE=grafana/grafana:11.4.0
LOKI_IMAGE=grafana/loki:3.3.2
PROMTAIL_IMAGE=grafana/promtail:3.3.2
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.16.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.25.0
BUSYBOX_IMAGE=busybox:1.37.0

# Grafana is published on loopback only; use an SSH tunnel in production.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://127.0.0.1:3000
# Chat webhook format: feishu, dingtalk, wecom or generic. The URL itself is
# in the secrets directory as alert_webhook_url.
ALERT_WEBHOOK_KIND=feishu
ALERT_ENVIRONMENT=production
ALERT_DIGEST_HOUR_UTC=9
# Alertmanager adapter; override only when moving the collector.
# ALERT_RUNBOOK_BASE_URL=https://github.com/nasa-du/rs-admin-ds/blob/main/docs/runbooks/alerting.md

# postgres_exporter uses rs_admin_monitor over verified TLS. For an external
# database, point it at the external host and CA; the CA must be mounted as
# internal_ca.pem.
# POSTGRES_EXPORTER_URI=postgres.example.com:5432/rs_admin?sslmode=verify-full&sslrootcert=/run/secrets/internal_ca
# POSTGRES_EXPORTER_USER=rs_admin_monitor

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=rs_admin
POSTGRES_USER=rs_admin
# Only used by deploy/compose.dev.yaml to publish the development database.
POSTGRES_PORT=5432
