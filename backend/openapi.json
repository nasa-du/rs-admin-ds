    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "healthLive",
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Server-generated request id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "healthReady",
        "responses": {
          "200": {
            "description": "Service is ready",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Server-generated request id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service is not ready",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Server-generated request id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "type": "object",
        "description": "`POST /auth/change-password` request body.",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ChangePasswordResponse": {
        "type": "object",
        "description": "`POST /auth/change-password` success body; the rotated refresh token is\nonly in the `Set-Cookie` header.",
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "token_type": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable, closed catalog of API error codes. Clients must map unknown future codes to a generic fallback.",
        "enum": [
          "invalid_json",
          "unknown_field",
          "unsupported_media_type",
          "method_not_allowed",
          "payload_too_large",
          "validation_failed",
          "invalid_sort",
          "page_size_too_large",
          "empty_update",
          "invalid_time_range",
          "time_range_too_large",
          "invalid_credentials",
          "access_token_invalid",
          "session_invalid",
          "refresh_token_invalid",
          "refresh_reuse_detected",
          "account_disabled",
          "temporary_password_expired",
          "login_locked",
          "rate_limited",
          "password_change_required",
          "csrf_failed",
          "reauth_required",
          "invalid_current_password",
          "forbidden",
          "out_of_scope",
          "self_action_forbidden",
          "role_immutable",
          "permission_subset_violation",
          "not_found",
          "identifier_taken",
          "role_name_taken",
          "role_in_use",
          "last_super_admin",
          "password_policy_violation",
          "password_unchanged",
          "unknown_role",
          "empty_permissions",
          "invalid_permission",
          "internal_error",
          "service_unavailable"
        ]
      },
      "FieldError": {
        "type": "object",
        "description": "A field-level validation error (JSON Pointer).",
        "required": [
          "pointer",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "params": {},
          "pointer": {
            "type": "string"
          }
        }
      },
      "HealthState": {
        "type": "string",
        "description": "Probe state returned by the health endpoints.",
        "enum": [
          "live",
          "ready",
          "unready"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "description": "Body returned by the health probes.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthState"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "`POST /auth/login` request body.",
        "required": [
          "identifier",
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Username or email address."
          },
          "password": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "description": "`POST /auth/login` success body.",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "token_type": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSelfResponse"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "description": "Request body for `POST /auth/logout` and `POST /auth/logout-all`. Both\nidentify the caller by cookie or Bearer token, so the body is an empty JSON\nobject.",
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 7807 problem document used for every API error.",
        "required": [
          "type",
          "code",
          "title",
          "status",
          "detail",
          "instance",
          "request_id"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "Stable error code from the closed catalog."
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "instance": {
            "type": "string"
