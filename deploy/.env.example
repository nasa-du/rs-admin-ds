# Copy to deploy/.env for the single-host stack. This file is non-secret;
# key material lives in the directory referenced by RS_ADMIN_SECRETS_DIR.
#
#   cp deploy/.env.example deploy/.env
#   ./scripts/generate-dev-secrets.sh
#
# For production replace RS_ADMIN_SECRETS_DIR with /etc/rs-admin/secrets, set
# APP_ENV=production, and point the image tags at immutable GHCR tags.

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=rs-admin
RS_ADMIN_SECRETS_DIR=./secrets-dev

# --- Images ----------------------------------------------------------------
POSTGRES_IMAGE=postgres:18.6-alpine
API_IMAGE=rs-admin-api:local
WEB_IMAGE=rs-admin-web:local
GIT_COMMIT=unknown

# --- Domains and browser origins ------------------------------------------
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
ADMIN_ORIGIN=https://admin.example.com
PUBLIC_API_ORIGIN=https://api.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com
# Origin only, no /api/v1 suffix: the generated client already carries it.
VITE_API_BASE_URL=https://api.example.com

# --- Runtime ---------------------------------------------------------------
# production requires HTTPS origins and sslmode=verify-full in the DSN.
APP_ENV=production
TRUSTED_PROXY_CIDRS=172.28.0.0/16
JWT_ISSUER=rs-admin
JWT_AUDIENCE=rs-admin-client
JWT_EDDSA_KID=dev-2026-11
AUDIT_CHAIN_KEY_ID=dev-2026-11
PASSWORD_HASH_CONCURRENCY=4
RUST_LOG=info,sqlx=warn

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=rs_admin
POSTGRES_USER=rs_admin
# Only used by deploy/compose.dev.yaml to publish the development database.
POSTGRES_PORT=5432
