[Unit]
Description=Quarterly rs-admin restore drill

[Timer]
# First day of January, April, July and October. Host timezone is UTC
# (ADR-0008 §1.3).
OnCalendar=*-01,04,07,10-01 05:30:00
Persistent=true
RandomizedDelaySec=30m
AccuracySec=1m
Unit=rs-admin-restore-drill.service

[Install]
WantedBy=timers.target
