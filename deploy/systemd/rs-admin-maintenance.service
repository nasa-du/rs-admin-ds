[Unit]
Description=rs-admin retention cleanup
Documentation=file:/opt/rs-admin/docs/runbooks/backup-restore.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=rs-admin-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/rs-admin/ops.env
WorkingDirectory=/opt/rs-admin/deploy
# The maintenance container runs as the API image uid 10001 and writes a
# Prometheus textfile.
ExecStartPre=/usr/bin/install -d -m 0755 -o 10001 -g 10001 ${RS_ADMIN_MAINTENANCE_METRICS_DIR}
ExecStart=/usr/bin/docker compose --profile tools run --rm maintenance
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
