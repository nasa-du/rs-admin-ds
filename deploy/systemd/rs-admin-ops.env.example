# Non-secret host settings for the rs-admin systemd timers. Install as
# /etc/rs-admin/ops.env and adjust the paths.
#
#   install -d -m 0750 /etc/rs-admin
#   install -m 0640 deploy/systemd/rs-admin-ops.env.example /etc/rs-admin/ops.env

# The units use the documented /opt/rs-admin install path.
# Created by rs-admin-backup.service; must be writable by uid/gid 70 and
# readable by node_exporter (for the textfile collector).
RS_ADMIN_METRICS_DIR=/var/lib/rs-admin/metrics
RS_ADMIN_MAINTENANCE_METRICS_DIR=/var/lib/rs-admin/metrics-maintenance
RESTORE_DRILL_STATE_DIR=/var/lib/rs-admin/restore-drills
# Optional: a generic webhook (Alertmanager adapter, Feishu, DingTalk, ...)
# notified when a timer job fails. The URL itself lives in a 0400 root file.
ALERT_WEBHOOK_URL_FILE=/etc/rs-admin/secrets/alert_webhook_url
